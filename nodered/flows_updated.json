        {
            "id": "hist_comment_01",
            "type": "comment",
            "z": "56abe4ae53a7c46f",
            "name": "── 歷史成績持久化（存檔 / HTTP 讀取）──",
            "info": "偵測 quiz/multi/state phase=end，將 history 物件寫入 history.json\nHTTP GET /quiz/history 讓 player.html 跨裝置讀取歷史紀錄",
            "x": 270,
