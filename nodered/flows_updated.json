        {
            "id": "ff6766546b5e0d83",
            "type": "function",
            "z": "56abe4ae53a7c46f",
            "name": "解析 IP",
            "func": "let raw = '';\nif (msg.payload && msg.payload.type === 'Buffer' && Array.isArray(msg.payload.data)) {\n    raw = Buffer.from(msg.payload.data).toString('utf8');\n} else if (Buffer.isBuffer(msg.payload)) {\n    raw = msg.payload.toString('utf8');\n} else if (typeof msg.payload === 'string') {\n    raw = msg.payload;\n} else {\n    raw = JSON.stringify(msg.payload);\n}\n\n// ★ Broker IP 從 Tab 環境變數讀取，只需在 Tab 屬性改一次 ★\nconst brokerIP = env.get('BROKER_IP') || '192.168.0.171';\nflow.set('brokerIP', brokerIP);\nconst brokerPrefix = brokerIP.split('.').slice(0, 3).join('.');\n\nconst re = /\\b(?!127\\.|169\\.254\\.|0\\.)(\\d{1,3}\\.){3}\\d{1,3}\\b/g;\nconst allIPs = [...raw.matchAll(re)].map(m => m[0]);\n\nif (allIPs.length === 0) { node.warn('未找到任何 IP'); return null; }\n\n// 優先選與 Broker 同 /24 網段的 IP（WiFi 接 broker 選 WiFi，Ethernet 接 broker 選 Ethernet）\nconst sameSubnet = allIPs.find(ip => ip.startsWith(brokerPrefix + '.'));\nconst ip = sameSubnet || allIPs[0];\n\nmsg.payload = ip;\nmsg._ipSource = sameSubnet ? '同網段' : '備用';\n\nnode.status({\n    fill:  sameSubnet ? 'green' : 'yellow',\n    shape: 'dot',\n    text:  (sameSubnet ? '同網段: ' : '備用: ') + ip\n});\n\nreturn msg;",
            "outputs": 1,
            "timeout": "",
            "noerr": 0,
            "initialize": "",
            "finalize": "",
            "libs": [],
            "x": 760,
            "y": 660,
            "wires": [
                [
                    "9c6486e692844e8d"
                ]
            ]
        },
        {
            "id": "9c6486e692844e8d",
            "type": "function",
            "z": "56abe4ae53a7c46f",
            "name": "組成 Discord Webhook 格式",
            "func": "const ip = String(msg.payload);\nconst source = msg._ipSource || '未知';\n\nif (!ip || ip === 'null') {\n    msg.payload = { username: 'Windows 主機', content: '❌ 未找到有效 IPv4' };\n    return msg;\n}\n\nconst brokerIP = flow.get('brokerIP') || '192.168.0.171';\nconst uiUrl      = `http://${ip}:1880/ui`;\nconst playerUrl  = `http://${ip}:5500/multi/player.html?ip=${brokerIP}&port=9001`;\nconst hostUrl    = 'http://127.0.0.1:5500/multi/host.html';\nconst lineDevUrl     = 'https://account.line.biz/login?redirectUri=https%3A%2F%2Fdevelopers.line.biz%2Fconsole%2Fchannel%2Fnew%3Ftype%3Dmessaging-api';\nconst lineManagerUrl = 'https://manager.line.biz/';\n\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = {\n    username: 'Windows 主機',\n    embeds: [{\n        title: '📡 Windows 主機 IP 更新',\n        description:\n            `你的電腦目前 IP：**\\`${ip}\\`** (${source})\\n\\n` +\n            `🖥️ UI 介面：\\n👉 ${uiUrl}\\n\\n` +\n            `🎮 玩家加入連結：\\n👉 ${playerUrl}\\n\\n` +\n            `🎤 主持人頁面：\\n👉 ${hostUrl}\\n\\n` +\n            `💬 LINE Developers：\\n👉 ${lineDevUrl}\\n\\n` +\n            `📱 LINE Manager：\\n👉 ${lineManagerUrl}`,\n        color: 3447003,\n        fields: [\n            { name: '🌐 主機 IP',         value: `\\`${ip}\\` (${source})`,                  inline: true  },\n            { name: '📡 Broker IP',       value: `\\`${brokerIP}\\``,                         inline: true  },\n            { name: '🎮 玩家連結',        value: `[加入遊戲](${playerUrl})`,               inline: false },\n            { name: '🎤 主持人',          value: `[主持人頁面](${hostUrl})`,               inline: true  },\n            { name: '💬 LINE Developers', value: `[開啟 LINE Developers](${lineDevUrl})`,  inline: false },\n            { name: '📱 LINE Manager',    value: `[開啟 LINE Manager](${lineManagerUrl})`, inline: false },\n            { name: '🔧 來源',            value: 'Node-RED 自動回報',                      inline: false }\n        ],\n        footer: { text: '系統自動回報 · SmartCane Node-RED' },\n        timestamp: new Date().toISOString()\n    }]\n};\n\nreturn msg;",
