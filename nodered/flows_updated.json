        {
            "id": "hist_mqtt_in",
            "type": "mqtt in",
            "z": "56abe4ae53a7c46f",
            "name": "quiz/multi/state (偵測 end)",
            "topic": "quiz/multi/state",
            "qos": "1",
            "datatype": "json",
            "broker": "ff1f1c66f72c9743",
            "nl": false,
            "rap": false,
            "rh": 0,
            "inputs": 0,
            "x": 170,
            "y": 920,
            "wires": [["hist_fn_save"]]
        },
        {
            "id": "hist_fn_save",
            "type": "function",
            "z": "56abe4ae53a7c46f",
            "name": "儲存歷史紀錄",
            "func": "const d = msg.payload;\nif (d.phase !== 'end' || !d.history || !Object.keys(d.history).length) return null;\nconst fs = require('fs');\n// 相對路徑（相對於啟動 Node-RED 時的工作目錄，需為專案根目錄 C:/question）\nconst filePath = 'multi/history.json';\ntry {\n    // 讀取現有完整紀錄\n    let existing = {};\n    try { existing = JSON.parse(fs.readFileSync(filePath, 'utf8')); } catch(e) {}\n\n    // 智慧合併：前端 games >= 後端 → 直接覆蓋；後端較多（localStorage 曾被清除）→ 疊加本局數據\n    Object.entries(d.history).forEach(([name, newData]) => {\n        const e = existing[name];\n        if (!e || newData.games >= e.games) {\n            // 新資料 games 更多（前端紀錄完整）或全新玩家 → 直接覆蓋\n            existing[name] = newData;\n        } else {\n            // 後端 games 較多（前端曾重置）→ 疊加本局實際數據，不丟棄\n            existing[name].games      += newData.games;\n            existing[name].totalScore += newData.totalScore;\n            existing[name].highScore   = Math.max(e.highScore, newData.highScore);\n            existing[name].firstCount += newData.firstCount;\n            existing[name].lastSeen    = Math.max(e.lastSeen || 0, newData.lastSeen || 0);\n        }\n    });\n\n    const count = Object.keys(existing).length;\n    fs.writeFileSync(filePath, JSON.stringify(existing, null, 2), 'utf8');\n    node.status({ fill:'green', shape:'dot', text:`合計 ${count} 位玩家 · ${new Date().toLocaleTimeString()}` });\n    msg.payload = `歷史成績已合併儲存（共 ${count} 位玩家）`;\n    return msg;\n} catch(e) {\n    node.error('寫檔失敗：' + e.message);\n    return null;\n}",
            "outputs": 1,
            "timeout": 0,
            "noerr": 0,
            "initialize": "",
            "finalize": "",
            "libs": [],
            "x": 400,
            "y": 920,
            "wires": [["hist_debug_save"]]
        },
        {
            "id": "hist_debug_save",
            "type": "debug",
            "z": "56abe4ae53a7c46f",
            "name": "歷史儲存結果",
            "active": true,
            "tosidebar": true,
