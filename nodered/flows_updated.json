            "id": "hist_fn_read",
            "type": "function",
            "z": "56abe4ae53a7c46f",
            "name": "讀取歷史 + CORS",
            "func": "const fs = require('fs');\n// 相對路徑（相對於啟動 Node-RED 時的工作目錄，需為專案根目錄 C:/question）\nconst filePath = 'multi/history.json';\ntry {\n    msg.payload = fs.readFileSync(filePath, 'utf8');\n} catch(e) {\n    msg.payload = '{}';\n}\nmsg.headers = {\n    'Content-Type': 'application/json',\n    'Access-Control-Allow-Origin': '*',\n    'Cache-Control': 'no-cache'\n};\nnode.status({ fill:'blue', shape:'dot', text: new Date().toLocaleTimeString() });\nreturn msg;",
