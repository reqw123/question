# 相依套件（可用 npm install 重新產生，不進版本控制）
node_modules/

# 玩家個人學習報告紀錄（launchers/serve-lan.js 的 /api/record-session 寫入），
# 屬於使用者個人作答資料，不進版本控制
/stats/

# electron-builder 打包輸出（可用 npm run dist 重新產生，不進版本控制）
control-center/dist/
desktop-pet/dist/

# desktop-pet 打包成 .exe 前，從 live2d_my_like/ 篩選複製出來的角色子集（可用
# npm run dist 或 node scripts/prepare-live2d-assets.js 重新產生，不進版本控制）
desktop-pet/pack-assets/

# 大型素材資料庫（私人收集的遊戲資源截取，體積過大不適合進版本控制）
Live2d-model-master/
live2d-master/
cat_data/

# desktop-pet 光粒子特效候選 GLB 模型：同上，私人收集的遊戲資源截取（LoL 角色皮膚
# 拆包），檔案動輒 10MB+，且授權來源不明，不適合進版本控制。
desktop-pet/particle-effect/models/
# ==================================================
