# 相依套件（可用 npm install 重新產生，不進版本控制）
node_modules/

# 大型素材資料庫（私人收集的遊戲資源截取，體積過大不適合進版本控制）
Live2d-model-master/
live2d-master/
live2d_my_like/models/
cat_data/

# 第三方執行檔（使用者可自行下載，不進版本控制）
caddy.exe

# 個人本機設定（跟 settings.json 分開，不共用）
.claude/settings.local.json

# 作業系統產生的檔案
Thumbs.db
.DS_Store

# Python 編譯快取（可重新產生，不進版本控制）
__pycache__/
*.pyc

# 由架構圖工具輸出的可再生預覽檔
archify-output/
